{
  "id": "pf1-new-script-hooks",
  "title": "PF1 New Script Hooks",
  "description": "<p>Adds additional hook points and script call categories for PF1 item actions. Provides pf1PreAttackDialog and pf1PostAttackDialog hooks, plus Pre-Activate, Pre-Use, Turn Start, Turn End, Pre-Toggle, Create, and Delete script call categories, and per-action Pre-Activate / Pre-Use / Use / Post-Use lists on the action sheet.</p>",
  "authors": [
    {
      "name": "Hamilcarbarcas",
      "flags": {}
    }
  ],
  "version": "0.0.0",
  "url": "https://github.com/Hamilcarbarcas/pf1-new-script-hooks",
  "readme": "https://github.com/Hamilcarbarcas/pf1-new-script-hooks/blob/main/README.md",
  "bugs": "https://github.com/Hamilcarbarcas/pf1-new-script-hooks/issues",
  "manifest": "https://github.com/Hamilcarbarcas/pf1-new-script-hooks/releases/latest/download/module.json",
  "download": "https://github.com/Hamilcarbarcas/pf1-new-script-hooks/releases/download/v1.0.0/module.zip",
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
  "relationships": {
    "systems": [
      {
        "id": "pf1",
        "type": "system"
      }
    ],
    "requires": [
      {
        "id": "lib-wrapper",
        "type": "module"
      }
    ]
  },
  "esmodules": [
    "src/scripts/dialog-hooks.mjs",
    "src/scripts/script-calls.mjs",
    "src/scripts/action-script-calls.mjs",
    "src/scripts/combat-hooks.mjs",
    "src/scripts/toggle-hooks.mjs",
    "src/scripts/create-hooks.mjs",
    "src/scripts/delete-hooks.mjs"
  ]
}
